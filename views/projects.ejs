<%- include('partials/header') %>
<main id="main-content" class="container section">
  <p class="eyebrow">Opportunities to serve</p>
  <h1>Upcoming Service Projects</h1>
  <p class="intro">Explore the next five upcoming projects organized by local service organizations.</p>
  <% if (projects.length === 0) { %>
    <p>No upcoming projects are scheduled. Please check back soon.</p>
  <% } %>
  <div class="card-grid">
    <% projects.forEach((project) => { %>
      <article class="card">
        <h2><a href="/project/<%= project.project_id %>"><%= project.title %></a></h2>
        <p><strong>Date:</strong> <%= formatProjectDate(project.date) %></p>
        <p><strong>Organization:</strong> <a href="/organization/<%= project.organization_id %>"><%= project.organization_name %></a></p>
        <p><%= project.description %></p>
        <p><strong>Location:</strong> <%= project.location %></p>
      </article>
    <% }) %>
  </div>
</main>
<%- include('partials/footer') %>
