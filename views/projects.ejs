<%- include('partials/header') %>
<main id="main-content" class="container section">
  <p class="eyebrow">Opportunities to serve</p>
  <h1>Service Projects</h1>
  <p class="intro">Explore upcoming projects organized by local service organizations.</p>
  <div class="card-grid">
    <% projects.forEach((project) => { %>
      <article class="card">
        <h2><%= new Date(project.date).toLocaleDateString('en-US', { timeZone: 'UTC', year: 'numeric', month: 'short', day: 'numeric' }) %>: <%= project.title %> (<em><%= project.organization_name %></em>)</h2>
        <p><%= project.description %></p>
        <p><strong>Location:</strong> <%= project.location %></p>
      </article>
    <% }) %>
  </div>
</main>
<%- include('partials/footer') %>
