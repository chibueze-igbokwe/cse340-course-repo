<%- include('partials/header') %>
<main id="main-content" class="container section">
  <h1>Dashboard</h1>
  <p><strong>Name:</strong> <%= name %></p>
  <p><strong>Email:</strong> <%= email %></p>
  <% if (isAdmin) { %>
    <p><a class="button" href="/users">Registered Users</a></p>
  <% } %>
  <p><a href="/projects">Browse service projects</a></p>
  <section aria-labelledby="my-volunteering">
    <h2 id="my-volunteering">My Volunteering</h2>
    <p>Review your projects and manage your volunteering.</p>
    <p><a class="button" href="/my-volunteering">View My Volunteering</a></p>
  </section>
</main>
<%- include('partials/footer') %>
