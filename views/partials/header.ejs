<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="description" content="Discover organizations and community service projects through Service Network.">
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <a class="skip-link" href="#main-content">Skip to content</a>
  <header class="site-header">
    <div class="container header-inner">
      <a class="brand" href="/">Service<span>Network</span></a>
      <nav aria-label="Main navigation">
        <a href="/">Home</a>
        <a href="/organizations">Organizations</a>
        <a href="/projects">Projects</a>
        <a href="/categories">Categories</a>
      </nav>
    </div>
  </header>
  <% const messages = flash(); %>
  <% Object.entries(messages).forEach(([type, entries]) => { %>
    <% entries.forEach((message) => { %>
      <div class="container alert <%= type %>" role="status"><%= message %></div>
    <% }); %>
  <% }); %>
