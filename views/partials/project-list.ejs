<% if (projects.length === 0) { %>
  <p>No service projects are listed yet. Please check back soon.</p>
<% } else { %>
  <ul class="card-grid project-list">
    <% projects.forEach((project) => { %>
      <li class="card">
        <h3><a href="/project/<%= project.project_id %>"><%= project.title %></a></h3>
        <p><%= project.description %></p>
        <p><strong>Date:</strong> <%= formatProjectDate(project.date) %></p>
        <p><strong>Location:</strong> <%= project.location %></p>
      </li>
    <% }) %>
  </ul>
<% } %>
