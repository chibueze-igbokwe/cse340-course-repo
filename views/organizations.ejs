<%- include('partials/header') %>
<main id="main-content" class="container section">
  <p class="eyebrow">People making an impact</p>
  <h1>Organizations</h1>
  <p class="intro">Explore organizations supporting their communities through practical service.</p>
  <% if (organizations.length === 0) { %>
    <p>No organizations are available yet. Please check back soon.</p>
  <% } %>
  <div class="card-grid">
    <% organizations.forEach((organization) => { %>
      <article class="card image-card">
        <img
          src="/images/<%= organization.logo %>"
          alt="<%= organization.name %> logo"
          loading="lazy"
        >
        <div class="card-body">
          <h2><a href="/organization/<%= organization.organization_id %>"><%= organization.name %></a></h2>
          <p><%= organization.description %></p>
          <p><a href="mailto:<%= organization.email %>"><%= organization.email %></a></p>
        </div>
      </article>
    <% }) %>
  </div>
</main>
<%- include('partials/footer') %>
