DB_URL=
# Week 05: use DB_URL only after pointing it to a confirmed isolated dev database.
# Integration checks accept only localhost and database cse340_development.
# Optional override; otherwise local DB_URL is used. Never set this to Render.
DEV_DB_URL=
# Integration account password is supplied privately through the environment:
GRADING_ADMIN_PASSWORD=
# Generate privately with Node crypto.randomBytes(64).toString('hex'). Never commit the result.
SESSION_SECRET=
NODE_ENV=development
PORT=3000
# Optional: writable persistent directory for file-backed sessions in hosting.
# SESSION_DIR=/var/data/service-network-sessions
