DB_URL=
# Week 05: use DB_URL only after pointing it to a confirmed isolated dev database.
# Optional read-only integration checks require a SEPARATE target and explicit confirmation:
DEV_DB_URL=
CONFIRM_ISOLATED_DATABASE=false
# Generate privately with Node crypto.randomBytes(64).toString('hex'). Never commit the result.
SESSION_SECRET=
NODE_ENV=development
PORT=3000
# Optional: writable persistent directory for file-backed sessions in hosting.
# SESSION_DIR=/var/data/service-network-sessions
